ANTHROPIC_API_KEY=sk-ant-...

# Optional — wires the staff "whisper" earpiece + Sandy narration + multilingual greetings.
# Without these set, /api/whisper and /api/synth fall back to browser SpeechSynthesis.
ELEVENLABS_API_KEY=

# Primary Sandy voice — used by default for all narration / whisper / greeting / ack
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optional second voice (male alternate) — toggle from staff UI via "voice" param
# Set this to a different ElevenLabs voice ID you've cloned or selected
ELEVENLABS_VOICE_ID_MALE=

# Model selection. Turbo is fast English-first. Multilingual v2 handles non-Latin
# scripts (Hebrew, Mandarin, Hindi, etc.) much better — synth route auto-picks
# multilingual_v2 for the "warm" voiceStyle (greeting flow) regardless of this default.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
